# Backend env vars — copy to .env and adjust per environment.
# DO NOT commit .env to git. On production hosts use a secret manager instead.

# ─── JWT signing key ─────────────────────────────────────────────────────
# REPLACE on prod with a long random string (min 32 chars). Anyone holding
# this key can forge tokens. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-on-production-use-openssl-rand-base64-48"

# ─── HTTP server ─────────────────────────────────────────────────────────
PORT=3000

# Allowed CORS origin for the frontend. Must exactly match the browser URL
# (including scheme + port). Use the production domain on prod.
FRONTEND_URL="http://localhost:5173"

# ─── PostgreSQL ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mustshare
DB_USER=postgres
DB_PASSWORD=change-me-on-production
